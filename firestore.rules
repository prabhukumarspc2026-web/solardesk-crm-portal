rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return hasActiveProfile() && role() == 'admin';
    }

    function isManagerOrAdmin() {
      return hasActiveProfile() && role() in ['admin', 'manager'];
    }

    function canAccessRecord(data) {
      return isManagerOrAdmin() || (hasActiveProfile() && data.assignedTo == request.auth.uid);
    }

    function canCreateRecord() {
      return isManagerOrAdmin()
        || (hasActiveProfile()
          && request.resource.data.assignedTo == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid);
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId
        || isManagerOrAdmin()
      );
      allow list: if isManagerOrAdmin();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'active'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.role in ['admin', 'manager', 'sales']
        && request.resource.data.active is bool;
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    match /{collection}/{recordId} {
      allow read: if collection in [
        'leads',
        'followups',
        'quotations',
        'installations',
        'payments'
      ] && canAccessRecord(resource.data);

      allow create: if collection in [
        'leads',
        'followups',
        'quotations',
        'installations',
        'payments'
      ] && canCreateRecord();

      allow update: if collection in [
        'leads',
        'followups',
        'quotations',
        'installations',
        'payments'
      ] && (
        isManagerOrAdmin()
        || (
          hasActiveProfile()
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedTo == request.auth.uid
        )
      );

      allow delete: if collection in [
        'leads',
        'followups',
        'quotations',
        'installations',
        'payments'
      ] && canAccessRecord(resource.data);
    }
  }
}
