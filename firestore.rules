rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return hasActiveProfile() && role() == 'admin';
    }

    function isBusinessManager() {
      return isAdmin();
    }

    function isSalesManager() {
      return hasActiveProfile() && role() == 'manager';
    }

    function isProjectManager() {
      return hasActiveProfile() && role() == 'project_manager';
    }

    function isManagerOrAdmin() {
      return isBusinessManager() || isSalesManager() || isProjectManager();
    }

    function validUserProfile(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'active'])
        && data.name is string
        && data.email is string
        && data.role in ['admin', 'manager', 'sales', 'project_manager', 'project_executive']
        && data.active is bool;
    }

    function canAccessRecord(data) {
      return isManagerOrAdmin() || (hasActiveProfile() && data.assignedTo == request.auth.uid);
    }

    function canCreateRecord() {
      return isManagerOrAdmin()
        || (hasActiveProfile()
          && request.resource.data.assignedTo == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid);
    }

    function historyParentPath(data) {
      return data.recordType == 'sales'
        ? /databases/$(database)/documents/leads/$(data.recordId)
        : data.recordType == 'project'
          ? /databases/$(database)/documents/installations/$(data.recordId)
          : data.recordType == 'quotation'
            ? /databases/$(database)/documents/quotations/$(data.recordId)
            : data.recordType == 'followup'
              ? /databases/$(database)/documents/followups/$(data.recordId)
              : data.recordType == 'collection'
                ? /databases/$(database)/documents/payments/$(data.recordId)
                : data.recordType == 'survey'
                  ? /databases/$(database)/documents/surveys/$(data.recordId)
                  : data.recordType == 'subsidy'
                    ? /databases/$(database)/documents/subsidies/$(data.recordId)
                    : data.recordType == 'loan'
                      ? /databases/$(database)/documents/loans/$(data.recordId)
                      : data.recordType == 'inventory'
                        ? /databases/$(database)/documents/inventory/$(data.recordId)
                        : data.recordType == 'amc'
                          ? /databases/$(database)/documents/amcs/$(data.recordId)
                          : /databases/$(database)/documents/serviceTickets/$(data.recordId);
    }

    function canCreateHistory() {
      let data = request.resource.data;
      let parentPath = historyParentPath(data);
      return hasActiveProfile()
        && data.recordType in ['sales', 'project', 'quotation', 'followup', 'collection', 'survey', 'subsidy', 'loan', 'inventory', 'amc', 'serviceTicket']
        && data.recordId is string
        && data.assignedTo is string
        && data.actorId == request.auth.uid
        && data.event is string
        && data.comment is string
        && exists(parentPath)
        && canAccessRecord(get(parentPath).data)
        && data.assignedTo == get(parentPath).data.assignedTo;
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId
        || isBusinessManager()
        || (isSalesManager() && resource.data.role == 'sales')
        || (isProjectManager() && resource.data.role in ['manager', 'sales', 'project_executive'])
      );
      allow list: if isBusinessManager()
        || (isSalesManager() && resource.data.role == 'sales')
        || (isProjectManager() && resource.data.role in ['manager', 'sales', 'project_executive']);

      allow create: if validUserProfile(request.resource.data)
        && (
          isBusinessManager()
          || (isSalesManager() && request.resource.data.role == 'sales')
          || (isProjectManager() && request.resource.data.role == 'project_executive')
        );
      allow update: if validUserProfile(request.resource.data)
        && (
          isBusinessManager()
          || (isSalesManager() && resource.data.role == 'sales' && request.resource.data.role == 'sales')
          || (isProjectManager() && resource.data.role == 'project_executive' && request.resource.data.role == 'project_executive')
        );
      allow delete: if userId != request.auth.uid && (
        isBusinessManager()
        || (isSalesManager() && resource.data.role == 'sales')
        || (isProjectManager() && resource.data.role == 'project_executive')
      );
    }

    match /{collection}/{recordId} {
      allow read: if collection == 'inventory' && hasActiveProfile();

      allow read: if collection in [
        'leads',
        'followups',
        'quotations',
        'installations',
        'payments',
        'history',
        'surveys',
        'subsidies',
        'loans',
        'amcs',
        'serviceTickets',
        'stockMovements'
      ] && canAccessRecord(resource.data);

      allow create, update, delete: if collection == 'inventory' && isManagerOrAdmin();
      allow create: if collection == 'stockMovements' && canCreateRecord() && isManagerOrAdmin();

      allow create: if (collection in [
          'leads',
          'followups',
          'quotations',
          'installations',
          'payments',
          'surveys',
          'subsidies',
          'loans',
          'amcs',
          'serviceTickets'
        ] && canCreateRecord())
        || (collection == 'history' && canCreateHistory());

      allow update: if collection in [
        'leads',
        'followups',
        'quotations',
        'installations',
        'payments',
        'surveys',
        'subsidies',
        'loans',
        'amcs',
        'serviceTickets'
      ] && (
        isManagerOrAdmin()
        || (
          hasActiveProfile()
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedTo == request.auth.uid
        )
      );

      allow delete: if collection in [
        'leads',
        'followups',
        'quotations',
        'installations',
        'payments',
        'surveys',
        'subsidies',
        'loans',
        'amcs',
        'serviceTickets'
      ] && canAccessRecord(resource.data);
    }
  }
}
