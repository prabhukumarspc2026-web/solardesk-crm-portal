rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(profilePath())
        && get(profilePath()).data.active == true
        && get(profilePath()).data.role != 'super_admin'
        && get(profilePath()).data.tenantId is string
        && exists(/databases/$(database)/documents/workspaces/$(get(profilePath()).data.tenantId))
        && get(/databases/$(database)/documents/workspaces/$(get(profilePath()).data.tenantId)).data.active == true;
    }

    function currentTenant() {
      return get(profilePath()).data.tenantId;
    }

    function workspacePath(tenant) {
      return /databases/$(database)/documents/workspaces/$(tenant);
    }

    function seatChangePath(tenant) {
      return /databases/$(database)/documents/workspaces/$(tenant)/internal/seatChange;
    }

    function directoryPath(tenant) {
      return /databases/$(database)/documents/tenantDirectory/$(tenant);
    }

    function workspace() {
      return get(workspacePath(currentTenant())).data;
    }

    function role() {
      return get(profilePath()).data.role;
    }

    function canonicalRole(targetRole) {
      return targetRole == 'admin' ? 'business_owner'
        : targetRole == 'manager' ? 'sales_manager'
        : targetRole == 'sales' ? 'sales_executive'
        : targetRole;
    }

    function isAdmin() {
      return hasActiveProfile() && canonicalRole(role()) == 'business_owner';
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(profilePath())
        && get(profilePath()).data.active == true
        && role() == 'super_admin';
    }

    function isSalesManager() {
      return hasActiveProfile() && canonicalRole(role()) == 'sales_manager';
    }

    function isProjectManager() {
      return hasActiveProfile() && role() == 'project_manager';
    }

    function isManagerOrAdmin() {
      return isAdmin() || isSalesManager() || isProjectManager();
    }

    function seatLimit(plan) {
      return plan == 'starter' ? 3 : plan == 'business' ? 5 : plan == 'scale' ? 15 : 0;
    }

    function planAllows(feature) {
      return isSuperAdmin()
        || feature in ['leads', 'followups', 'surveys', 'quotations', 'installations']
        || (workspace().plan in ['business', 'scale']
          && feature in ['payments', 'subsidies', 'loans'])
        || (workspace().plan == 'scale'
          && feature in ['inventory', 'stockMovements', 'reports', 'afterSales', 'amcs', 'serviceTickets']);
    }

    function featureForCollection(collection) {
      return collection == 'leads' ? 'leads'
        : collection == 'followups' ? 'followups'
        : collection == 'quotations' ? 'quotations'
        : collection == 'installations' ? 'installations'
        : collection == 'surveys' ? 'surveys'
        : collection == 'payments' ? 'payments'
        : collection == 'subsidies' ? 'subsidies'
        : collection == 'loans' ? 'loans'
        : collection == 'inventory' ? 'inventory'
        : collection == 'stockMovements' ? 'stockMovements'
        : collection == 'amcs' ? 'amcs'
        : collection == 'serviceTickets' ? 'serviceTickets'
        : '';
    }

    function validTenant(data) {
      return (isSuperAdmin()
          && data.tenantId is string
          && exists(workspacePath(data.tenantId)))
        || (hasActiveProfile() && data.tenantId == currentTenant());
    }

    function canAccessRecord(data) {
      return isSuperAdmin()
        || (hasActiveProfile()
          && (isManagerOrAdmin() || data.assignedTo == request.auth.uid));
    }

    function canManageRole(targetRole) {
      return isAdmin()
        || (isSalesManager() && canonicalRole(targetRole) == 'sales_executive')
        || (isProjectManager() && canonicalRole(targetRole) == 'project_executive');
    }

    function activeSeatWithinLimit() {
      let tenantWorkspace = getAfter(workspacePath(currentTenant())).data;
      return tenantWorkspace.activeUserCount <= seatLimit(tenantWorkspace.plan);
    }

    function validUserProfile(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'active', 'tenantId'])
        && data.name is string
        && data.email is string
        && data.role in ['business_owner', 'sales_manager', 'sales_executive', 'project_manager', 'project_executive']
        && data.active is bool
        && data.tenantId == currentTenant();
    }

    function validNewCompanyOwner(data) {
      return isSuperAdmin()
        && data.keys().hasAll(['name', 'email', 'role', 'active', 'tenantId'])
        && data.name is string
        && data.email is string
        && data.role == 'business_owner'
        && data.active == true
        && data.tenantId is string
        && !exists(workspacePath(data.tenantId))
        && existsAfter(workspacePath(data.tenantId))
        && getAfter(workspacePath(data.tenantId)).data.active == true
        && getAfter(workspacePath(data.tenantId)).data.activeUserCount == 1
        && existsAfter(directoryPath(data.tenantId));
    }

    function validSuperAdminTenantUser(data) {
      return isSuperAdmin()
        && data.keys().hasAll(['name', 'email', 'role', 'active', 'tenantId'])
        && data.name is string
        && data.email is string
        && data.role in ['business_owner', 'sales_manager', 'sales_executive', 'project_manager', 'project_executive']
        && data.active is bool
        && data.tenantId is string
        && exists(workspacePath(data.tenantId));
    }

    function validNewWorkspace(data, workspaceId) {
      return isSuperAdmin()
        && data.keys().hasAll(['name', 'plan', 'active', 'activeUserCount', 'updatedAt'])
        && data.keys().hasOnly(['name', 'plan', 'active', 'activeUserCount', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.plan in ['starter', 'business', 'scale']
        && data.active == true
        && data.activeUserCount == 1
        && data.updatedAt is string
        && existsAfter(directoryPath(workspaceId))
        && getAfter(directoryPath(workspaceId)).data.name == data.name
        && getAfter(directoryPath(workspaceId)).data.plan == data.plan
        && getAfter(directoryPath(workspaceId)).data.active == data.active
        && getAfter(directoryPath(workspaceId)).data.activeUserCount == data.activeUserCount;
    }

    function validNewDirectory(data, workspaceId) {
      let tenantWorkspace = getAfter(workspacePath(workspaceId)).data;
      return isSuperAdmin()
        && data.keys().hasAll(['name', 'plan', 'active', 'activeUserCount', 'updatedAt'])
        && data.keys().hasOnly(['name', 'plan', 'active', 'activeUserCount', 'updatedAt'])
        && existsAfter(workspacePath(workspaceId))
        && data.name == tenantWorkspace.name
        && data.plan == tenantWorkspace.plan
        && data.active == tenantWorkspace.active
        && data.activeUserCount == tenantWorkspace.activeUserCount
        && data.updatedAt is string;
    }

    function validDirectorySubscriptionUpdate(data, workspaceId) {
      let tenantWorkspace = getAfter(workspacePath(workspaceId)).data;
      return isSuperAdmin()
        && data.diff(resource.data).affectedKeys().hasOnly(['plan', 'active', 'updatedAt'])
        && data.name == tenantWorkspace.name
        && data.plan == tenantWorkspace.plan
        && data.active == tenantWorkspace.active
        && data.activeUserCount == tenantWorkspace.activeUserCount
        && data.updatedAt is string;
    }

    function validDirectorySeatUpdate(data, workspaceId) {
      let tenantWorkspace = getAfter(workspacePath(workspaceId)).data;
      return (isSuperAdmin()
          && data.diff(resource.data).affectedKeys().hasOnly(['activeUserCount', 'updatedAt'])
          && data.name == tenantWorkspace.name
          && data.plan == tenantWorkspace.plan
          && data.active == tenantWorkspace.active
          && data.activeUserCount == tenantWorkspace.activeUserCount
          && data.updatedAt is string)
        || (hasActiveProfile()
          && currentTenant() == workspaceId
          && isManagerOrAdmin()
          && data.diff(resource.data).affectedKeys().hasOnly(['activeUserCount', 'updatedAt'])
          && data.name == tenantWorkspace.name
          && data.plan == tenantWorkspace.plan
          && data.active == tenantWorkspace.active
          && data.activeUserCount == tenantWorkspace.activeUserCount
          && data.updatedAt is string);
    }

    function validUserSeatChange() {
      let oldActive = resource.data.active == true;
      let newActive = request.resource.data.active == true;
      let countBefore = get(workspacePath(currentTenant())).data.activeUserCount;
      let countAfter = getAfter(workspacePath(currentTenant())).data.activeUserCount;
      return oldActive == newActive
        || (countAfter == countBefore + (newActive ? 1 : -1)
          && (!newActive || countAfter <= seatLimit(getAfter(workspacePath(currentTenant())).data.plan)));
    }

    function validNewUserSeat() {
      let countBefore = get(workspacePath(currentTenant())).data.activeUserCount;
      let countAfter = getAfter(workspacePath(currentTenant())).data.activeUserCount;
      return request.resource.data.active != true
        || (countAfter == countBefore + 1
          && countAfter <= seatLimit(getAfter(workspacePath(currentTenant())).data.plan));
    }

    function validWorkspaceSeatUpdate(tenant) {
      let seatChange = getAfter(seatChangePath(tenant)).data;
      let memberPath = /databases/$(database)/documents/users/$(seatChange.userId);
      let wasActive = exists(memberPath) && get(memberPath).data.active == true;
      let isActive = existsAfter(memberPath) && getAfter(memberPath).data.active == true;
      let countChange = isActive && !wasActive ? 1 : (!isActive && wasActive ? -1 : 0);
      let member = getAfter(memberPath).data;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activeUserCount', 'updatedAt'])
        && request.resource.data.activeUserCount == resource.data.activeUserCount + countChange
        && getAfter(directoryPath(tenant)).data.activeUserCount == request.resource.data.activeUserCount
        && countChange != 0
        && seatChange.userId is string
        && ((seatChange.action == 'activate' && !wasActive && isActive)
          || (seatChange.action == 'deactivate' && wasActive && !isActive))
        && member.tenantId == tenant
        && canManageRole(member.role)
        && (!isActive || request.resource.data.activeUserCount <= seatLimit(request.resource.data.plan));
    }

    function validSeatChange(data, tenant) {
      let memberPath = /databases/$(database)/documents/users/$(data.userId);
      let wasActive = exists(memberPath) && get(memberPath).data.active == true;
      let isActive = existsAfter(memberPath) && getAfter(memberPath).data.active == true;
      let member = getAfter(memberPath).data;
      return data.keys().hasOnly(['userId', 'action', 'updatedAt'])
        && data.userId is string
        && data.action in ['activate', 'deactivate']
        && data.updatedAt is string
        && existsAfter(memberPath)
        && member.tenantId == tenant
        && canManageRole(member.role)
        && ((data.action == 'activate' && !wasActive && isActive)
          || (data.action == 'deactivate' && wasActive && !isActive));
    }

    function collectionAllowed(collection) {
      return collection == 'catalog' || planAllows(featureForCollection(collection));
    }

    function canCreateRecord(collection) {
      return validTenant(request.resource.data)
        && collectionAllowed(collection)
        && (isManagerOrAdmin()
          || (request.resource.data.assignedTo == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid));
    }

    function historyFeatureMatches(data) {
      return (data.recordType == 'sales' && data.feature == 'leads')
        || (data.recordType == 'quotation' && data.feature == 'quotations')
        || (data.recordType == 'followup' && data.feature == 'followups')
        || (data.recordType == 'collection' && data.feature == 'payments')
        || (data.recordType == 'project' && data.feature == 'installations')
        || (data.recordType == 'survey' && data.feature == 'surveys')
        || (data.recordType == 'subsidy' && data.feature == 'subsidies')
        || (data.recordType == 'loan' && data.feature == 'loans')
        || (data.recordType == 'inventory' && data.feature == 'inventory')
        || (data.recordType in ['amc', 'serviceTicket'] && data.feature == 'afterSales');
    }

    match /workspaces/{workspaceId} {
      allow get: if isSuperAdmin()
        || (hasActiveProfile() && currentTenant() == workspaceId);
      allow list: if isSuperAdmin();
      allow create: if validNewWorkspace(request.resource.data, workspaceId);
      allow delete: if false;
      allow update: if isSuperAdmin()
          || (hasActiveProfile()
          && currentTenant() == workspaceId
          && isManagerOrAdmin()
          && validWorkspaceSeatUpdate(workspaceId));
    }

    match /tenantDirectory/{workspaceId} {
      allow get, list: if isSuperAdmin();
      allow create: if validNewDirectory(request.resource.data, workspaceId);
      allow update: if validDirectorySubscriptionUpdate(request.resource.data, workspaceId)
        || validDirectorySeatUpdate(request.resource.data, workspaceId);
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/internal/{documentId} {
      allow read, list: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
        || (documentId == 'seatChange'
          && hasActiveProfile()
          && currentTenant() == workspaceId
          && isManagerOrAdmin()
          && validSeatChange(request.resource.data, workspaceId));
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if isSuperAdmin() || signedIn() && (
        request.auth.uid == userId
        || (hasActiveProfile()
          && !exists(/databases/$(database)/documents/users/$(userId))
          && isManagerOrAdmin())
        || (hasActiveProfile()
          && resource.data.tenantId == currentTenant()
          && (isAdmin()
            || (isSalesManager() && canonicalRole(resource.data.role) == 'sales_executive')
            || (isProjectManager() && canonicalRole(resource.data.role) in ['sales_manager', 'sales_executive', 'project_executive']))
        )
      );
      allow list: if isSuperAdmin()
        || (hasActiveProfile()
          && resource.data.tenantId == currentTenant()
          && (isAdmin()
            || (isSalesManager() && canonicalRole(resource.data.role) == 'sales_executive')
            || (isProjectManager() && canonicalRole(resource.data.role) in ['sales_manager', 'sales_executive', 'project_executive'])));
      allow create: if (isSuperAdmin() && validNewCompanyOwner(request.resource.data))
        || (isSuperAdmin() && validSuperAdminTenantUser(request.resource.data))
        || (!isSuperAdmin()
          && validUserProfile(request.resource.data)
          && canManageRole(request.resource.data.role)
          && validNewUserSeat());
      allow update: if (isSuperAdmin()
          && resource.data.role != 'super_admin'
          && validSuperAdminTenantUser(request.resource.data)
          && request.resource.data.tenantId == resource.data.tenantId)
        || (validUserProfile(request.resource.data)
          && resource.data.tenantId == currentTenant()
          && request.resource.data.tenantId == resource.data.tenantId
          && canManageRole(resource.data.role)
          && (isAdmin()
            || canonicalRole(request.resource.data.role) == canonicalRole(resource.data.role))
          && validUserSeatChange());
      allow delete: if false;
    }

    match /{collection}/{recordId} {
      allow read: if isSuperAdmin()
        || collection == 'catalog'
          && validTenant(resource.data)
        || collection == 'inventory'
          && planAllows('inventory')
          && validTenant(resource.data)
        || collection == 'history'
          && validTenant(resource.data)
          && historyFeatureMatches(resource.data)
          && planAllows(resource.data.feature)
          && canAccessRecord(resource.data)
        || collection in [
          'leads', 'followups', 'quotations', 'installations', 'payments',
          'surveys', 'subsidies', 'loans', 'stockMovements', 'amcs', 'serviceTickets'
        ]
          && collectionAllowed(collection)
          && validTenant(resource.data)
          && canAccessRecord(resource.data);

      allow create: if isSuperAdmin()
          && collection in [
            'leads', 'followups', 'quotations', 'installations', 'payments',
            'surveys', 'subsidies', 'loans', 'inventory', 'catalog',
            'stockMovements', 'amcs', 'serviceTickets', 'history'
          ]
          && validTenant(request.resource.data)
        || collection == 'catalog'
          && validTenant(request.resource.data)
          && isManagerOrAdmin()
        || collection == 'inventory'
          && planAllows('inventory')
          && canCreateRecord(collection)
          && isManagerOrAdmin()
        || collection == 'stockMovements'
          && planAllows('stockMovements')
          && canCreateRecord(collection)
          && isManagerOrAdmin()
        || collection == 'history'
          && validTenant(request.resource.data)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.assignedTo is string
          && historyFeatureMatches(request.resource.data)
          && planAllows(request.resource.data.feature)
          && canAccessRecord(request.resource.data)
        || collection in [
          'leads', 'followups', 'quotations', 'installations', 'payments',
          'surveys', 'subsidies', 'loans', 'amcs', 'serviceTickets'
        ]
          && canCreateRecord(collection);

      allow update: if isSuperAdmin()
          && collection in [
            'leads', 'followups', 'quotations', 'installations', 'payments',
            'surveys', 'subsidies', 'loans', 'inventory', 'catalog',
            'stockMovements', 'amcs', 'serviceTickets', 'history'
          ]
          && validTenant(resource.data)
          && validTenant(request.resource.data)
        || collection == 'catalog'
          && validTenant(resource.data)
          && validTenant(request.resource.data)
          && request.resource.data.tenantId == resource.data.tenantId
          && isManagerOrAdmin()
        || collection == 'inventory'
          && planAllows('inventory')
          && validTenant(resource.data)
          && validTenant(request.resource.data)
          && request.resource.data.tenantId == resource.data.tenantId
          && isManagerOrAdmin()
        || collection in [
          'leads', 'followups', 'quotations', 'installations', 'payments',
          'surveys', 'subsidies', 'loans', 'amcs', 'serviceTickets'
        ]
          && collectionAllowed(collection)
          && validTenant(resource.data)
          && validTenant(request.resource.data)
          && request.resource.data.tenantId == resource.data.tenantId
          && canAccessRecord(resource.data)
          && (isManagerOrAdmin() || request.resource.data.assignedTo == request.auth.uid);

      allow delete: if isSuperAdmin()
          && collection in [
            'leads', 'followups', 'quotations', 'installations', 'payments',
            'surveys', 'subsidies', 'loans', 'inventory', 'catalog',
            'stockMovements', 'amcs', 'serviceTickets', 'history'
          ]
          && validTenant(resource.data)
        || collection == 'catalog'
          && validTenant(resource.data)
          && isManagerOrAdmin()
        || collection == 'inventory'
          && planAllows('inventory')
          && validTenant(resource.data)
          && isManagerOrAdmin()
        || collection in [
          'leads', 'followups', 'quotations', 'installations', 'payments',
          'surveys', 'subsidies', 'loans', 'amcs', 'serviceTickets'
        ]
          && collectionAllowed(collection)
          && validTenant(resource.data)
          && canAccessRecord(resource.data);
    }
  }
}
